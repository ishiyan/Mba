<table width=3D"40%" border=3D"0" align=3D"CENTER" bgcolor=3D"#BCB449">
<tbody><tr>
<td align=3D"CENTER"><font face=3D"Arial" size=3D"+1" color=3D"#000000">Com=
parisons +
Lab Results</font></td>
</tr>
</tbody></table>
<br>
<br>
<center>
<a href=3D"http://jurikres.com/quotes1/feedback_1.htm#ama"><img align=3D"BO=
TTOM" src=3D"http://jurikres.com/gifs1/ama_quo1.gif" width=3D"729" height=
